# Copy to .env and fill in. Never commit .env.

# Long random value, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=change-me

# true in production (HTTPS). false only for local testing over http://127.0.0.1
SMSBRIDGE_COOKIE_SECURE=true

# The first account can always be created. Set true to allow more accounts.
SMSBRIDGE_ALLOW_REGISTRATION=false

# true when running behind the bundled proxy (profile "proxy")
SMSBRIDGE_TRUST_PROXY=false

# Public host name for the proxy profile, e.g. sms.example.org
SMSBRIDGE_DOMAIN=

# Local port the API is bound to on 127.0.0.1
SMSBRIDGE_LOCAL_PORT=8080

# Local port the dashboard is bound to on 127.0.0.1
SMSBRIDGE_WEB_PORT=8081

# Long random value: lets tools/publish-release.sh announce app updates. Leave empty to disable.
SMSBRIDGE_ADMIN_TOKEN=

# Folder with published APKs, served at /download/ by the web container
SMSBRIDGE_DOWNLOADS_DIR=./downloads
