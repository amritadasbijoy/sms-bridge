<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Telephony is optional so the app still installs (in archive-only mode) on Wi-Fi tablets. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Read the existing messages in the Telephony provider (runtime permission). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Receive the SMS_RECEIVED broadcast for new incoming messages (runtime permission). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Optional: which SIM (1 or 2) a message used, shown as "SIM 1 · carrier" in the browser. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Re-arm periodic reconciliation after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- New-message notifications in default SMS app mode (runtime permission on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Encrypted sync with the linked computers (HTTPS) and phone-to-phone transfer over local Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps the phone reachable for approval requests while the app is closed (shown as a notification). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- QR scanning for pairing (requested only when the user taps "Scan"). Camera is optional. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SmsBridgeApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsBridge"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SmsBridge"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing links from the web dashboard (same as scanning its QR code). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="smsbridge" android:host="pair" />
                <data android:scheme="smsbridge" android:host="login" />
            </intent-filter>
        </activity>

        <!-- Default SMS app components, sending and self-updates: src/web/AndroidManifest.xml. -->

        <!-- Keeps the encrypted connection to linked computers open (both builds). -->
        <service
            android:name=".data.cloud.CloudConnectionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!--
            Incoming SMS while SMS Bridge is NOT the default SMS app.
            BROADCAST_SMS guarantees only the system can deliver this broadcast.
        -->
        <receiver
            android:name=".data.sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.background.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager is initialised on demand with the Hilt worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
            <!-- QR scanner, kept upright. -->
        <activity
            android:name=".feature.sync.PortraitCaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
    </application>
</manifest>
