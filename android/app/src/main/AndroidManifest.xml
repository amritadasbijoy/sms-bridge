<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Telephony is optional so the app still installs (in archive-only mode) on Wi-Fi tablets. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Read the existing messages in the Telephony provider (runtime permission). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Receive the SMS_RECEIVED broadcast for new incoming messages (runtime permission). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Re-arm periodic reconciliation after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sending, used only while SMS Bridge is the default SMS app (the SMS role grants it). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- New-message notifications in default SMS app mode (runtime permission on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Device-to-device transfer over the local Wi-Fi (Phase 4b): TLS sockets between two paired
        phones only. SMS Bridge makes no other network connections.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps the phone reachable for approval requests while the app is closed (shown as a notification). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Lets the user exclude SMS Bridge from battery optimisation (asked once, from the Sync tab). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- QR scanning for pairing (requested only when the user taps "Scan"). Camera is optional. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SmsBridgeApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsBridge"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SmsBridge"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing links from the web dashboard (same as scanning its QR code). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="smsbridge" android:host="pair" />
                <data android:scheme="smsbridge" android:host="login" />
            </intent-filter>
            <!-- SMS role requirement: compose from sms:/smsto:/mms:/mmsto: links. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- ===== Default SMS app (SMS role) components ===== -->

        <receiver
            android:name=".data.sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Required by the role. MMS is not supported; the user is notified instead. -->
        <receiver
            android:name=".data.sms.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.cloud.CloudConnectionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
        <service
            android:name=".data.sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Per-part sent results and delivery reports for our own PendingIntents. -->
        <receiver
            android:name=".data.sms.SmsStatusReceiver"
            android:exported="false" />

        <!--
            Incoming SMS while SMS Bridge is NOT the default SMS app.
            BROADCAST_SMS guarantees only the system can deliver this broadcast.
        -->
        <receiver
            android:name=".data.sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.background.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager is initialised on demand with the Hilt worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
